{
  "dependencies": {
    "@atomos-web/prime-style": "workspace:*",
    "@atomos-web/structura-core": "workspace:*",
    "@binaryjack/formular.dev": "file:../../.codernic/packages/@binaryjack/formular.dev/layers/frontend"
  },
  "devDependencies": {
    "@vitest/ui": "^4.1.2",
    "jsdom": "^29.0.1",
    "typescript": "^5.3.0",
    "vitest": "^4.1.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./*"
  },
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "name": "@atomos-web/prime",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "powershell -Command \"Remove-Item -Force -Recurse dist -ErrorAction SilentlyContinue; exit 0\"",
    "dev": "tsc -p tsconfig.build.json --watch",
    "docs": "vite docs --port 3030",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "2.3.10"
}
