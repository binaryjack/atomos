{
  "dependencies": {
    "@atomos-web/prime": "workspace:*",
    "@atomos-web/prime-style": "workspace:*",
    "@atomos-web/renderer-svg": "workspace:*",
    "@atomos-web/structura-core": "workspace:*",
    "@binaryjack/formular.dev": "^2.4.0",
    "elkjs": "0.9.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "glob": "^10.0.0",
    "react": "19.2.4",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0",
    "y-protocols": "1.0.6",
    "yjs": "13.6.20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": "./*",
    "./neura": {
      "types": "./dist/widgets/neura/index.d.ts",
      "import": "./dist/widgets/neura/index.js",
      "require": "./dist/widgets/neura/index.js",
      "default": "./dist/widgets/neura/index.js"
    },
    "./webview": {
      "types": "./dist/app/webview/index.d.ts",
      "import": "./dist/app/webview/index.js",
      "require": "./dist/app/webview/index.js",
      "default": "./dist/app/webview/index.js"
    },
    "./webview/iife": {
      "default": "./dist/webview/index.iife.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "AGPL-3.0-or-later",
  "main": "./dist/index.js",
  "name": "@atomos-web/structura",
  "peerDependencies": {
    "y-protocols": "1.0.6",
    "yjs": "13.6.20"
  },
  "peerDependenciesMeta": {
    "y-protocols": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && vite build && BUILD_TARGET=webview-iife vite build",
    "build:webview-iife": "BUILD_TARGET=webview-iife vite build",
    "clean": "rimraf dist",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts",
    "serve": "vite",
    "test": "vitest run --passWithNoTests",
    "type-check": "tsc --noEmit"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "6.1.1"
}
