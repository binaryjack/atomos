{
  "name": "@atomos-web/structura",
  "version": "2.3.38",
  "license": "AGPL-3.0-or-later",

  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./webview": {
      "types": "./dist/webview/index.d.ts",
      "import": "./dist/webview/index.js",
      "require": "./dist/webview/index.js",
      "default": "./dist/webview/index.js"
    },
    "./neura": {
      "types": "./dist/neura/index.d.ts",
      "import": "./dist/neura/index.js",
      "require": "./dist/neura/index.js",
      "default": "./dist/neura/index.js"
    },
    "./*": "./*"
  },
  "scripts": {
    "build": "node scripts/gen-version.mjs && vite build",
    "build:webview-iife": "BUILD_TARGET=webview-iife vite build",
    "dev": "vite build --watch",
    "serve": "vite",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@atomos-web/prime": "^2.3.10",
    "@atomos-web/prime-style": "^2.3.10",
    "@atomos-web/structura-core": "^2.3.12",
    "@atomos-web/structura-mcp": "^2.3.22",
    "@atomos-web/renderer-svg": "^1.0.2",
    "@binaryjack/formular.dev": "^2.3.9"
  },

  "devDependencies": {
    "glob": "^10.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.0.0"
  }
}
